@model IEnumerable<Logica.ViewModels.CancionesViewModel>

@{
    ViewData["Title"] = "VerContenidoListaReproduccion";
}

<h1>Lista: @ViewBag.NombreLista</h1>
<a id="boton" style="background-color:mediumpurple;" href="@Url.Action("VerTodasLasListas", "VistaUsuario")" class="btn btn-link mb-2">
    <i class="fa-solid fa-arrow-left me-2" style="color:white;"></i> Volver a ver las listas de reproducción
</a>

<table class="table">
    <thead>
        <tr>
            <th>Carátula</th>
            <th>Reproducir</th>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Artista)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Album)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Duracion)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <div class="disco" id="disco-@item.idCancion">
                        <img src="@item.RutaCaratulaAlbum" alt="Carátula" />
                    </div>
                </td>
                <td>
                    <!-- Cambiamos el estadar de Visual Studio por el de MediaElement.js -->
                    <audio id="audio-@item.idCancion" class="mejs-player" controls preload="none">
                        <!-- El preload="none" evita cargar el audio automáticamente hasta que el usuario interactúe con él -->
                        <source src="@item.RutaArchivo" type="audio/mp3" />
                    </audio>

                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Artista)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Album)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Duracion)
                </td>

                <td>
                </td>
            </tr>
        }
    </tbody>
</table>
<!--Como comparten estilos y scripts usaremos la que se usa en vistaUsuario-->

<link href="~/css/HomeVistaUsuario/estilosHomeVistaUsuario.css" rel="stylesheet" />
<style>
    #boton {
        display: inline-block;
        background-color: mediumpurple;
        color: white;
        padding: 10px 20px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: bold;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

        #boton i {
            margin-right: 8px;
            transition: transform 0.4s ease;
        }

        #boton:hover {
            background-color: #7b3fd0;
            transform: scale(1.05);
            box-shadow: 0 6px 12px rgba(0,0,0,0.3);
            text-decoration: none;
        }

            #boton:hover i {
                transform: rotate(20deg);
            }
</style>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/js/HomeVistaUsuario/audio-player.js"></script>
    <script src="~/js/HomeVistaUsuario/busqueda.js"></script>
}
