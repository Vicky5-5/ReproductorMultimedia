@{
    ViewData["Title"] = "Modo Online - Spotify";
}

<h2>Modo Online: Buscar en Spotify</h2>

<input type="text" id="searchInput" placeholder="Escribe una canción, artista o álbum" />
<button onclick="searchSpotify()">Buscar</button>

<ul id="results"></ul>

<script>
    var accessToken = "TU_ACCESS_TOKEN"; // Reemplaza con el token obtenido vía OAuth

    function searchSpotify() {
        var query = document.getElementById("searchInput").value;
        var url = "https://api.spotify.com/v1/search?q=" + encodeURIComponent(query) + "&type=track&limit=10";

        var xhr = new XMLHttpRequest();
        xhr.open("GET", url, true);
        xhr.setRequestHeader("Authorization", "Bearer " + accessToken);

        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4 && xhr.status === 200) {
                var data = JSON.parse(xhr.responseText);
                var resultsList = document.getElementById("results");
                resultsList.innerHTML = "";

                if (data.tracks && data.tracks.items.length > 0) {
                    for (var i = 0; i < data.tracks.items.length; i++) {
                        var track = data.tracks.items[i];
                        var li = document.createElement("li");
                        li.innerHTML = `
                            <strong>${track.name}</strong> - ${track.artists[0].name}<br/>
                            <img src="${track.album.images[0].url}" width="100" /><br/>
                            <audio controls src="${track.preview_url}"></audio>
                        `;
                        resultsList.appendChild(li);
                    }
                } else {
                    resultsList.innerHTML = "<li>No se encontraron resultados.</li>";
                }
            }
        };

        xhr.send();
    }
</script>
