@model IEnumerable<Logica.ViewModels.ListaReproduccionViewModel>

@{
    ViewData["Title"] = "ListaPropia";
}

<h1>@ViewBag.NombreLista</h1>

<table class="table">
    <thead>
        <tr>
            <th>Nombre Lista</th>

        </tr>
        <tr>
            <th>Fecha de Creación</th>

        </tr>

        <tr></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a href="@Url.Action("VerContenidoListaReproduccion", "VistaUsuario", new { idLista = item.idLista })">
                        @Html.DisplayFor(modelItem => item.NombreLista)
                    </a>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.fechaCreacion)
                </td>
                <td>
                    <form method="post" action="@Url.Action("BorrarLista", "VistaUsuario", new { idLista = item.idLista })" style="display:inline;">
                        <button type="submit" class="btn-icono" title="Borrar lista" onclick="return confirm('¿Estás seguro de que quieres borrar esta lista?');">
                            <i class="fas fa-trash-alt" style="color: red; font-size: 21px;"></i>
                        </button>
                    </form>

                </td>

            </tr>
        }
    </tbody>
</table>
<style>
    .table {
        background-color: #f8f9fa;
        border-radius: 8px;
    }

    .btn-icono {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
    }


    .like {
        margin: 0 10px;
        font-size: 22px;
        text-decoration: none;
        transition: transform 0.2s ease;
        display: inline-block;
        color: grey;
    }

        .like:hover {
            transform: scale(1.2);
            color: #C73636;
        }

    .like-activo i {
        color: #C73636;
    }

    .lista {
        margin: 0 10px;
        font-size: 22px;
        text-decoration: none;
        transition: transform 0.2s ease;
        display: inline-block;
        color: grey;
    }

        .lista:hover {
            transform: scale(1.2);
            color: #C73636;
        }

    .lista-activo i {
        color: #C73636;
    }

    .disco {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: radial-gradient(circle, #333 30%, #111 70%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.4);
        position: relative;
    }

        .disco img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            z-index: 1;
        }
    /* Aquí se personaliza la barra de audio */

    .mejs__container {
        background-color: #171717;
        border: 1px solid #ddd;
        border-radius: 6px;
    }

    .mejs__time-current {
        background: #C73636 !important;
    }

    .mejs__time-loaded {
        background: #bbb;
    }

    .mejs__button > button {
        color: #C73636;
    }

    .btn-favoritas {
        display: inline-block;
        background-color: #ff4b5c;
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px 20px;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
        box-shadow: 0 4px 10px rgba(199, 54, 54, 0.3);
    }

        .btn-favoritas i {
            margin-right: 8px;
            transition: transform 0.4s ease;
        }

        .btn-favoritas:hover {
            background-color: #c73636; /* tono más oscuro */
            transform: scale(1.05);
            box-shadow: 0 6px 14px rgba(0,0,0,0.3);
            text-decoration: none;
            color: white;
        }

            .btn-favoritas:hover i {
                transform: rotate(15deg);
            }
    /*Estilos de la barra de búsqueda*/
    .lupa {
        background: none;
        border: none;
        cursor: pointer;
        color: #333;
        font-size: 18px;
        transition: color 0.3s ease;
    }

    .busqueda-container {
        max-width: 400px;
        margin-bottom: 20px;
    }

    .input-con-lupa {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
        background-color: white;
    }

        .input-con-lupa input {
            flex: 1;
            padding: 10px 12px;
            border: none;
            outline: none;
            font-size: 16px;
        }

        .input-con-lupa .separador {
            width: 1px;
            height: 60%;
            background-color: #ccc;
            margin: 0 10px;
        }

        .input-con-lupa .lupa {
            background: none;
            border: none;
            padding: 10px;
            cursor: pointer;
            font-size: 18px;
            color: #333;
        }

            .input-con-lupa .lupa:hover {
                color: #007bff;
            }
</style>


